# ==============================================================================
# TAMWEEL AI - MASTER ENVIRONMENT CONFIGURATION (Docker Compose)
# ==============================================================================
# Copy this file to `.env` in the root directory before running docker-compose up.
# Do not commit the `.env` file to version control.

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# SUPABASE_URL: The REST URL of your Supabase PostgreSQL instance.
SUPABASE_URL=https://<your-project>.supabase.co

# SUPABASE_KEY: The service_role key (bypasses RLS for secure backend operations).
SUPABASE_KEY=<your-service-role-key>

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: Used to sign and verify JWT tokens. Must be at least 32 chars.
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-string

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend domains.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ------------------------------------------------------------------------------
# 3. AI Providers
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY: Required for Claude Sonnet 4.6 (Score Explanations)
ANTHROPIC_API_KEY=<your-anthropic-key>

# OPENROUTER_API_KEY: Required for OpenAI embeddings and fallback routing
OPENROUTER_API_KEY=<your-openrouter-key>

# DEEPSEEK_API_KEY: Required for the primary RAG Chat Assistant
DEEPSEEK_API_KEY=<your-deepseek-key>

# ------------------------------------------------------------------------------
# 4. Frontend Configuration
# ------------------------------------------------------------------------------
# VITE_API_URL: The URL where the FastAPI backend is accessed by the browser.
VITE_API_URL=http://localhost:8000
