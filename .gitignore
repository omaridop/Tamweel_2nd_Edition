# ==============================================================================
# TAMWEEL AI — .gitignore (Updated for Hackathon Submission)
# ==============================================================================

# ------------------------------------------------------------------------------
# SECRETS & CREDENTIALS — Never commit these
# ------------------------------------------------------------------------------
.env
*.env
!.env.example
!**/.env.example

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
.eggs/
dist/
build/
*.so

# ------------------------------------------------------------------------------
# Node / Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ------------------------------------------------------------------------------
# OS / Editor artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------------------------------------------
# Testing & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
*.cover

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
dump.rdb
*.rdb

# ------------------------------------------------------------------------------
# Local run state / ephemeral JSON
# ------------------------------------------------------------------------------
latest_run.json
runs.json

# ------------------------------------------------------------------------------
# Chat exports & diff files (internal coordination artifacts)
# ------------------------------------------------------------------------------
chat_diff.txt
chat_diff_utf8.txt
hybrid_diff.txt
chat_out.txt

# ------------------------------------------------------------------------------
# Internal working reports (dev process, not product docs)
# Used during development; not meaningful to judges or contributors.
# ------------------------------------------------------------------------------
BUG_FIX_VALIDATION_REPORT.md
FINAL_INTEGRATED_REPORT.md
FINAL_POLISH_REPORT.md
KNOWLEDGE_BASE_UPDATE_REPORT.md
RAG_FAILURE_DIAGNOSTIC_REPORT.md
P0_SECRET_ROTATION_GUIDE.sh
README_VISUAL_ENHANCEMENT_REPORT.md

# docs/archives — internal triage & working notes
docs/archives/chat_out.txt
docs/archives/after_complexity.txt
docs/archives/after_maintainability.txt
docs/archives/baseline_complexity.txt
docs/archives/baseline_maintainability.txt
docs/archives/db_schema.txt
docs/archives/sklearn_calib.txt
docs/archives/tree.txt
docs/archives/tree2.txt
docs/archives/phases.txt
docs/archives/user_phases.txt
docs/archives/security_advice.md
docs/archives/RAG_DIAGNOSTIC_REPORT.md
docs/archives/TAMWEEL_AUDIT_REPORT.md
docs/archives/PROJECT_CONTEXT_SUMMARY.md

# ------------------------------------------------------------------------------
# Backend-side scratch & debug outputs
# ------------------------------------------------------------------------------
backend/investigate_output.txt
backend/out.txt
backend/output.txt
backend/parent_content.txt
backend/structured_financial_plan.md

# ------------------------------------------------------------------------------
# Root-level scratch / one-off test scripts
# (Quick-fire API / DB tests used during development)
