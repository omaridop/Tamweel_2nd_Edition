# ==============================================================================
# TAMWEEL AI - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# SUPABASE_URL: The REST URL of your Supabase PostgreSQL instance.
# Example: https://xyz.supabase.co
SUPABASE_URL=

# SUPABASE_KEY: The service_role key (bypasses RLS for secure backend operations).
# WARNING: Never expose this key to the frontend.
SUPABASE_KEY=

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: Used to sign and verify JWT tokens.
# Must be at least 32 random characters. Server refuses to start without this.
JWT_SECRET_KEY=

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed frontend domains.
# Do not use wildcard (*) in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. AI Providers
# ------------------------------------------------------------------------------
# ANTHROPIC_API_KEY: Required for Claude Sonnet 4.6 (Score Explanations)
ANTHROPIC_API_KEY=

# OPENROUTER_API_KEY: Required for OpenAI embeddings and fallback routing
OPENROUTER_API_KEY=

# DEEPSEEK_API_KEY: Required for the primary RAG Chat Assistant
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 4. Cache (Optional if using Docker)
# ------------------------------------------------------------------------------
# REDIS_URL: Connection string for caching LLM responses.
# Default (Docker): redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
